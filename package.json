{
  "name": "domain-mapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --build",
    "verify": "npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "npm run test:e2e --workspace @domain-mapper/app",
    "dev": "npm run dev --workspace @domain-mapper/app",
    "build": "npm run build --workspace @domain-mapper/app"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
